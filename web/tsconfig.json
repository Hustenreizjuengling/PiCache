{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "lib": ["es2023", "dom", "dom.iterable"],
    "types": ["svelte", "vite/client"],
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "allowJs": true,
    "checkJs": true,
    "moduleDetection": "force",
    "paths": {
      "$lib": ["./src/lib"],
      "$lib/*": ["./src/lib/*"],
      "$i18n": ["./src/i18n"],
      "$i18n/*": ["./src/i18n/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.svelte"]
}
