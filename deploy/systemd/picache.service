# PiCache: filtering DNS server + download cache.
# Installed by deploy/install.sh to /usr/local/lib/systemd/system/picache.service.
# Local changes belong in a drop-in (`systemctl edit picache`), not in this file.
[Unit]
Description=PiCache DNS filter + download cache
Documentation=https://github.com/hustenreizjuengling/picache/blob/main/docs/DEPLOYMENT.md
Wants=network-online.target
After=network-online.target remote-fs.target
# Deliberately no RequiresMountsFor=: DNS must start even if the NAS is down.

[Service]
Type=simple
User=picache
Group=picache
# Bootstrap settings (PICACHE_*); the CLI reads the same file.
EnvironmentFile=-/etc/picache/picache.env
ExecStart=/usr/local/bin/picache serve
# Also restarts after "Restart" in the UI (exit code 75).
Restart=always
RestartSec=2s

# /var/lib/picache (databases, keys) and /var/cache/picache (local cache
# store), both owned by picache. NAS stores live below /srv/picache, which is
# never a *Directory= path (systemd would chown the share recursively).
StateDirectory=picache
StateDirectoryMode=0750
CacheDirectory=picache
CacheDirectoryMode=0750
# /var/log/picache for PICACHE_LOG_FILE=/var/log/picache/picache.log (off
# by default; the journal always gets the log).
LogsDirectory=picache
LogsDirectoryMode=0750
ReadWritePaths=-/srv/picache

# Bind :53, :80, :443 and :853 (and UDP 67 and 547 while the DHCP server is
# switched on in the web UI, also later at run time, and 123/udp for the
# NTP server with PICACHE_NTP_LISTEN=:123) as an unprivileged user.
# CAP_NET_RAW only opens the raw ICMPv6 socket at start while IPv6 router
# advertisements are on; PiCache drops it on every thread right after start
# and refuses to run if that fails (capset is allowed below for exactly
# that). No other capability.
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_RAW
NoNewPrivileges=yes

# Under CPU or I/O contention PiCache gets twice the share of a service with
# the default weight 100 (sshd included): a mild bias, no starvation. Inside
# the process DNS still competes with the download cache. No effect where
# the cgroup controller is not delegated (some containers) or the I/O
# scheduler ignores weights (none, mq-deadline).
CPUWeight=200
IOWeight=200

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
# No ProtectClock=yes: its own seccomp filter refuses adjtimex even with
# modes 0 (read only), which the NTP server uses to read whether the host
# clock is synchronised (SystemCallFilter=adjtimex below). The clock stays
# out of reach: CAP_SYS_TIME is not in the bounding set, so the kernel
# refuses adjtimex with modes other than 0 (EPERM), and clock_settime,
# settimeofday and clock_adjtime stay outside @system-service. The /dev/rtc
# devices are hidden by PrivateDevices=yes. Checked on 2026-09-27 with
# systemd 252 (Debian 12) and 257 (Debian 13), each as PID 1 of a container,
# with these settings as a non-root user: adjtimex with modes 0 succeeds,
# adjtimex with ADJ_TICK and clock_settime fail with EPERM; with
# ProtectClock=yes added, adjtimex with modes 0 fails with EPERM too
# (SystemCallFilter=adjtimex does not re-allow it), so it stays off.
ProtectHostname=yes
ProtectProc=invisible
# Not ProcSubset=pid: PiCache reads /proc/filesystems, /proc/net/* and
# /proc/self/mountinfo for diagnostics and the mount guard.
# AF_NETLINK is needed for the interface list (net.Interfaces).
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# Safe for the pure-Go (CGO_ENABLED=0) binary.
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
# Re-allowed so PiCache can drop CAP_NET_RAW (see above).
SystemCallFilter=capset
# Re-allowed to read the clock state for the NTP server (see ProtectClock).
SystemCallFilter=adjtimex
SystemCallErrorNumber=EPERM
UMask=0027
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
