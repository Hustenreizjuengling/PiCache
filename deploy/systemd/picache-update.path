# PiCache updates from the web UI: starts the root helper whenever the web
# UI queues an update. Installed by install.sh unless --without-updater.
[Unit]
Description=Watch for PiCache update requests
Documentation=https://github.com/hustenreizjuengling/picache/blob/main/docs/DEPLOYMENT.md
# Removing this file disables updates from the web UI (also run: systemctl disable --now picache-update.path).
ConditionPathExists=/etc/picache/updater.enabled

[Path]
# The unprivileged service writes this file (a version and nothing else);
# it never downloads or installs anything itself. Unlike PathChanged=, the
# path is checked again when the helper exits, so a request queued while
# the helper runs starts it once more instead of being lost.
PathExists=/var/lib/picache/update-requests/request
# A request the helper was working on when it was killed: the next run
# reports it as failed, removes it and makes sure PiCache is running.
PathExists=/var/lib/picache/update-requests/.claim
# With a custom PICACHE_DATA_DIR, install.sh replaces both paths with a
# drop-in (picache-update.path.d/50-picache-paths.conf).
MakeDirectory=no
Unit=picache-update.service

[Install]
WantedBy=paths.target
